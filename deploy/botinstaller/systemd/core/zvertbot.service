[Unit]
Description=ZverTBot Telegram Bot
After=network.target

[Service]
WorkingDirectory={{INSTALL_DIR}}
Environment=PYTHONPATH={{INSTALL_DIR}}:{{INSTALL_DIR}}/config
Type=simple
User=root
ExecStart={{INSTALL_DIR}}/.venv/bin/python {{INSTALL_DIR}}/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
