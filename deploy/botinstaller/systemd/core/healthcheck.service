[Unit]
Description=Healthcheck HTTP Endpoint for ZverTBot
After=network.target vps-stats.service stats-http.service

Wants=vps-stats.service stats-http.service

[Service]
WorkingDirectory={{INSTALL_DIR}}
Environment=PYTHONPATH={{INSTALL_DIR}}
Type=simple
ExecStart={{INSTALL_DIR}}/.venv/bin/python {{INSTALL_DIR}}/hass/health/healthcheck.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
