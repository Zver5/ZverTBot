# ============================================================
# Настройки окружения ZverTBot
# ============================================================
# Скопируйте этот файл в .env и укажите реальные значения.
# Файл .env содержит секреты и не должен добавляться в Git.


# ============================================================
# Telegram
# ============================================================
# Токен Telegram-бота, полученный у @BotFather.
BOT_TOKEN=

# ID административного чата или несколько ID через запятую.
# Например: 123456789,987654321
ADMIN_CHAT=


# ============================================================
# VPS / сервер
# ============================================================
# Публичный IP-адрес VPS.
SERVER_IP=

# Флаг, используемый ботом для обозначения страны VPS-сервера.
SERVER_FLAG=🌐


# ============================================================
# Доступ к Home Assistant
# ============================================================
# Необязательно.
# IP-адрес Home Assistant, используемый для доступа к HASS
# через SSH-туннель.
# Если доступ к Home Assistant не используется — оставить пустым.
HA_TUNNEL_IP=

# Флаг, используемый ботом для обозначения страны сервера Home Assistant.
HASS_FLAG=🌍


# ============================================================
# Xray
# ============================================================
# Необязательно.
# Путь к конфигурации Xray.
# Значение по умолчанию: /usr/local/etc/xray/config.json
XRAY_CONF=/usr/local/etc/xray/config.json


# ============================================================
# AmneziaWG
# ============================================================
# Необязательно.
# Путь к конфигурации AmneziaWG сервера.
# Если оставить пустым, путь определяется автоматически
# по стандартным конфигурациям AWG.
AWG_CONF=


# ============================================================
# Healthcheck / Uptime Kuma
# ============================================================
# Необязательно.
# URL endpoint, который используется для проверки состояния бота.
KUMA_HEALTHCHECK_URL=http://127.0.0.1:8081/status


# ============================================================
# LLM — диагностика логов
# ============================================================
# Необязательно.
#
# LLM_PROVIDER — провайдер LLM.
# Поддерживаемые значения:
#   groq       — Groq
#   openrouter — OpenRouter
#   openai     — OpenAI
#
# После выбора провайдера API URL и список моделей можно
# не указывать: для каждого провайдера в config/secrets.py
# уже заданы значения по умолчанию.
LLM_PROVIDER=groq

# API-ключ выбранного LLM-провайдера.
LLM_API_KEY=

# Необязательно.
# URL API для запросов к LLM.
# Если оставить пустым, используется URL из настроек выбранного провайдера.
LLM_API_URL=

# Необязательно.
# Основная модель, которая используется первой.
# Если оставить пустым, берётся первая модель из списка
# для выбранного LLM_PROVIDER.
LLM_MODEL=

# Необязательно.
# Резервные модели через запятую.
# Если основная модель недоступна, сервис последовательно
# пробует следующие модели.
LLM_MODELS=


# ============================================================
# AbuseIPDB
# ============================================================
# Необязательно.
# API-ключ AbuseIPDB для проверки репутации IP-адресов.
ABUSEIPDB_API_KEY=

# -----------------------------------------------------------------------------
# Резервное копирование через rclone
# -----------------------------------------------------------------------------
# Имя remote, настроенного в rclone.
# Например: yandex
# Если резервное копирование пока не настроено — оставьте пустым.
BACKUP_REMOTE=yandex

# Корневая папка для резервных копий внутри rclone remote.
# Внутри неё используются:
#   VPS/configs
#   VPS/passport
# Если резервное копирование пока не настроено — оставьте пустым.
BACKUP_ROOT_DIR=VPS
